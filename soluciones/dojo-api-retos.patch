+)
+
+// CajaController expone /cajas.
+type CajaController struct {
+	cajaService services.CajaService
+}
+
+func NewCajaController(cajaService services.CajaService) *CajaController {
+	return &CajaController{cajaService: cajaService}
+}
+
+// GetPorAlmacen godoc
+// @Summary     Lista las cajas de un almacén
+// @Tags        cajas
+// @Produce     json
+// @Security    BearerToken
+// @Param       almacen_id query    int true "ID del almacén"
+// @Success     200        {object} general.Respuesta
+// @Failure     400        {object} dtos.RespuestaError
+// @Router      /cajas [get]
+func (c *CajaController) GetPorAlmacen(ctx *gin.Context) {
+	almacenID, err := strconv.ParseUint(ctx.Query("almacen_id"), 10, 64)
+	if err != nil || almacenID == 0 {
+		apperr.CtrlResponse(http.StatusBadRequest, "El parámetro almacen_id es requerido", errors.New("almacen_id inválido"), ctx)
+		return
+	}
+	cajas, err := c.cajaService.PorAlmacen(ctx.Request.Context(), uint(almacenID))
+	if err != nil {
+		apperr.Response(err, ctx)
+		return
+	}
+	general.Responder(http.StatusOK, "Cajas consultadas", mappers.ToCajaDTOs(cajas), ctx)
+}
+
+// Alta godoc
+// @Summary     Registra una caja
+// @Tags        cajas
+// @Accept      json
+// @Produce     json
+// @Security    BearerToken
+// @Param       caja body     dtos.CajaAltaDTO true "Caja"
+// @Success     201  {object} general.Respuesta
+// @Failure     400  {object} dtos.RespuestaError
+// @Failure     404  {object} dtos.RespuestaError
+// @Router      /cajas [post]
+func (c *CajaController) Alta(ctx *gin.Context) {
+	var req dtos.CajaAltaDTO
+	if err := ctx.ShouldBindJSON(&req); err != nil {
+		apperr.CtrlResponse(http.StatusBadRequest, msgLeerDatos, err, ctx)
+		return
+	}
+	caja := models.Caja{Nombre: req.Nombre, AlmacenID: req.AlmacenID}
+	if err := c.cajaService.Registrar(ctx.Request.Context(), &caja); err != nil {
+		apperr.Response(err, ctx)
+		return
+	}
+	general.Responder(http.StatusCreated, "Caja registrada", mappers.ToCajaDTO(caja), ctx)
+}

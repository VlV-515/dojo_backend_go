+package dtos
+
+// CajaDTO es una caja tal como sale por la API.
+type CajaDTO struct {
+	ID        uint   `json:"id" example:"1"`
+	Nombre    string `json:"nombre" example:"Caja 1"`
+	AlmacenID uint   `json:"almacen_id" example:"1"`
+	Abierta   bool   `json:"abierta" example:"false"`

+package postgres
+
+import (
+	"context"
+	"net/http"
+
+	"gorm.io/gorm"
+
+	"github.com/VlV-515/dojo_backend_go/practica/dojo-api/pkg/apperr"
+	"github.com/VlV-515/dojo_backend_go/practica/dojo-api/src/domain/models"
+	"github.com/VlV-515/dojo_backend_go/practica/dojo-api/src/domain/repositories"
+)
+
+var (
+	_ repositories.CajaReader = (*CajaRepositoryImpl)(nil)
+	_ repositories.CajaWriter = (*CajaRepositoryImpl)(nil)
+)
+
+type CajaRepositoryImpl struct {
+	db *gorm.DB
+}
+
+func NewCajaRepository(db *gorm.DB) *CajaRepositoryImpl {
+	return &CajaRepositoryImpl{db: db}
+}
+
+func (r *CajaRepositoryImpl) PorAlmacen(ctx context.Context, almacenID uint) ([]models.Caja, error) {
+	cajas := []models.Caja{}
+	if err := txOrDB(ctx, r.db).Where("almacen_id = ?", almacenID).Order("id").Find(&cajas).Error; err != nil {
+		return nil, apperr.New(http.StatusInternalServerError, "No fue posible consultar cajas debido a un error interno", err)
+	}
+	return cajas, nil
+}
+
+func (r *CajaRepositoryImpl) Insertar(ctx context.Context, caja *models.Caja) error {
+	if err := txOrDB(ctx, r.db).Create(caja).Error; err != nil {
+		return apperr.New(http.StatusInternalServerError, "No fue posible crear la caja debido a un error interno", err)
+	}
+	return nil
+}

+
+const msgCajaNombre = "El campo nombre es requerido"
+
+// CajaService orquesta las cajas de cada almacén.
+type CajaService interface {
+	PorAlmacen(ctx context.Context, almacenID uint) ([]models.Caja, error)
+	// Registrar responde 404 si el almacén no existe.
+	Registrar(ctx context.Context, caja *models.Caja) error
+}
+
+type CajaServiceImpl struct {
+	reader   repositories.CajaReader
+	writer   repositories.CajaWriter
+	almacens repositories.AlmacenReader
+}
+
+func NewCajaService(reader repositories.CajaReader, writer repositories.CajaWriter, almacenes repositories.AlmacenReader) *CajaServiceImpl {
+	return &CajaServiceImpl{reader: reader, writer: writer, almacens: almacenes}
+}
+
+func (s *CajaServiceImpl) PorAlmacen(ctx context.Context, almacenID uint) ([]models.Caja, error) {
+	cajas, err := s.reader.PorAlmacen(ctx, almacenID)
+	if err != nil {
+		return nil, apperr.Wrap(err)
+	}
+	return cajas, nil
+}
+
+func (s *CajaServiceImpl) Registrar(ctx context.Context, caja *models.Caja) error {
+	caja.Nombre = strings.TrimSpace(caja.Nombre)
+	if caja.Nombre == "" {
+		return badRequest(msgCajaNombre)
+	}
+	if _, err := s.almacens.PorID(ctx, caja.AlmacenID); err != nil {
+		return apperr.Wrap(err)
+	}
+	caja.Abierta = false
+	if err := s.writer.Insertar(ctx, caja); err != nil {
+		return apperr.Wrap(err)
+	}
+	return nil
+}

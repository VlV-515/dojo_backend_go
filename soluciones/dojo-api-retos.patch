+package memoria
+
+import (
+	"context"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/VlV-515/dojo_backend_go/practica/dojo-api/src/domain/models"
+	"github.com/VlV-515/dojo_backend_go/practica/dojo-api/src/domain/repositories"
+)
+
+var (
+	_ repositories.CajaReader = (*CajaRepositoryImpl)(nil)
+	_ repositories.CajaWriter = (*CajaRepositoryImpl)(nil)
+)
+
+type CajaRepositoryImpl struct {
+	mu        sync.Mutex
+	siguiente uint
+	cajas     map[uint]models.Caja
+}
+
+func NewCajaRepository() *CajaRepositoryImpl {
+	return &CajaRepositoryImpl{siguiente: 1, cajas: map[uint]models.Caja{}}
+}
+
+func (r *CajaRepositoryImpl) PorAlmacen(_ context.Context, almacenID uint) ([]models.Caja, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	lista := []models.Caja{}
+	for _, c := range r.cajas {
+		if c.AlmacenID == almacenID {
+			lista = append(lista, c)
+		}
+	}
+	sort.Slice(lista, func(i, j int) bool { return lista[i].ID < lista[j].ID })
+	return lista, nil
+}
+
+func (r *CajaRepositoryImpl) Insertar(_ context.Context, caja *models.Caja) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	ahora := time.Now()
+	caja.ID = r.siguiente
+	caja.CreatedAt, caja.UpdatedAt = ahora, ahora
+	r.cajas[caja.ID] = *caja
+	r.siguiente++
+	return nil
+}
